<%- include('partials/header', { title: 'Employee List' }) %>

<div class="card shadow-sm">
  <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
    <h5 class="mb-0">Employee Directory</h5>
    <a href="/new" class="btn btn-light fw-semibold">+ Add Employee</a>
  </div>
  <div class="card-body p-0">
    <table class="table table-hover table-striped mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>Name</th>
          <th>Gender</th>
          <th>Salary</th>
          <th>Address</th>
          <th style="width: 180px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (employees.length === 0) { %>
          <tr>
            <td colspan="5" class="text-center text-muted py-4">No employees found.</td>
          </tr>
        <% } else { %>
          <% employees.forEach(emp => { %>
            <tr>
              <td><%= emp.name %></td>
              <td><%= emp.gender %></td>
              <td>$<%= emp.salary.toLocaleString() %></td>
              <td><%= emp.address %></td>
              <td>
                <div class="d-flex gap-2">
                  <a href="/edit/<%= emp._id %>" class="btn btn-sm btn-outline-warning">Edit</a>
                  <form action="/delete/<%= emp._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this employee?')" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
